{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GastroAI multi-turn conversation sample",
  "type": "object",
  "required": ["id", "language", "split", "source_ids", "review_status", "synthetic", "dataset_version", "disclaimer", "task", "category", "turns", "evaluation"],
  "properties": {
    "id": {"type": "string", "pattern": "^CONV-[0-9]{4}$"},
    "language": {"const": "vi"},
    "split": {"enum": ["development", "test"]},
    "review_status": {"const": "unreviewed"},
    "synthetic": {"const": true},
    "task": {"const": "multi_turn_conversation"},
    "turns": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {"role": {"enum": ["user", "assistant"]}, "content": {"type": "string", "minLength": 1}}
      }
    },
    "evaluation": {"type": "object", "required": ["expected_final_action", "requires_follow_up_question", "must_preserve_context"]}
  },
  "additionalProperties": true
}
