{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GastroAI RAG evaluation sample",
  "type": "object",
  "required": ["id", "language", "split", "source_ids", "review_status", "synthetic", "dataset_version", "disclaimer", "task", "category", "topic", "question", "expected_answer", "evaluation"],
  "properties": {
    "id": {"type": "string", "pattern": "^RAG-[0-9]{4}$"},
    "language": {"const": "vi"},
    "split": {"enum": ["development", "test"]},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "review_status": {"const": "unreviewed"},
    "synthetic": {"const": true},
    "task": {"const": "rag_qa"},
    "category": {"enum": ["direct_knowledge", "multi_hop", "insufficient_context", "misconception_correction"]},
    "topic": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 10},
    "expected_answer": {"type": "string", "minLength": 20},
    "evaluation": {"type": "object", "required": ["must_include", "must_not_include", "requires_citation"]}
  },
  "additionalProperties": true
}
