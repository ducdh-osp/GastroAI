{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GastroAI structured triage evaluation sample",
  "type": "object",
  "required": ["id", "language", "split", "source_ids", "review_status", "synthetic", "dataset_version", "disclaimer", "task", "scenario_text", "input", "expected"],
  "properties": {
    "id": {"type": "string", "pattern": "^TRIAGE-[0-9]{4}$"},
    "language": {"const": "vi"},
    "split": {"enum": ["development", "test"]},
    "review_status": {"const": "unreviewed"},
    "synthetic": {"const": true},
    "task": {"const": "structured_triage"},
    "input": {
      "type": "object",
      "required": ["primarySymptom", "primarySymptomDetail", "duration", "reportedSeverity", "activityImpact", "progression", "patientGroup", "warningSigns"]
    },
    "expected": {
      "type": "object",
      "required": ["severity", "emergency", "careRecommendation", "matchedGroups", "reasons", "needsClinicianReview", "urgency", "safe_action"],
      "properties": {
        "severity": {"enum": ["MILD", "MODERATE", "SEVERE", "UNDETERMINED"]},
        "emergency": {"type": "boolean"},
        "careRecommendation": {"enum": ["EMERGENCY_CARE", "SEE_DOCTOR", "SELF_CARE_AT_HOME"]},
        "matchedGroups": {"type": "array", "items": {"type": "string"}},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "needsClinicianReview": {"type": "boolean"}
      }
    }
  },
  "additionalProperties": true
}
